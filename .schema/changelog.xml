<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.0.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">
    <changeSet author="Jaera" id="1">
        <createTable tableName="custom_command">
            <column name="command_name" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="server_id" type="VARCHAR(255)">
                    <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_username" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="link" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="custom_command_usage">
            <column name="command_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="server_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="calling_username" type="VARCHAR(255)"/>
            <column name="usage_date" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseColumnNames="command_name,server_id"
                baseTableName="custom_command_usage"
                referencedColumnNames="command_name,server_id"
                referencedTableName="custom_command"
                constraintName="command_name_usage_base_command_exists"
        />
    </changeSet>
    <changeSet author="Jaera" id="2">
        <renameColumn
                tableName="custom_command"
                oldColumnName="server_id"
                newColumnName="guild_id"
        />
    </changeSet>
    <changeSet author="Jaera" id="3">
        <createTable tableName="ab_history">
            <column name="uuid" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="server_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="roll_type" type="VARCHAR(255)"/>
            <column name="roll_date" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="player_lookup">
            <column name="uuid" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="batter_card_path" type="VARCHAR(255)"/>
            <column name="pitcher_card_path" type="VARCHAR(255)"/>
            <column name="year" type="VARCHAR(255)" />
            <column name="active" type="boolean" defaultValue="true"/>
        </createTable>
        <createTable tableName="fielding_range">
            <column name="roll" type="integer">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="position" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="values" type="VARCHAR(255)">
                    <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="fielding_error">
            <column name="roll" type="integer">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="position" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="e_rating" type="integer">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="value" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet author="Jaera" id="4">
        <createTable tableName="chart">
            <column name="chart_name" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="server_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="channel_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="TEXT" />
            <column name="description" type="TEXT" />
            <column name="image_link" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="chart_usage">
            <column name="chart_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="server_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="channel_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="calling_username" type="VARCHAR(255)"/>
            <column name="usage_date" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseColumnNames="chart_name,server_id,channel_id"
                baseTableName="chart_usage"
                referencedColumnNames="chart_name,server_id,channel_id"
                referencedTableName="chart"
                constraintName="chart_name_usage_base_chart_exists"
        />
    </changeSet>
    <changeSet author="Jaera" id="5">
        <dropColumn tableName="chart_usage" columnName="channel_id"/>
        <dropColumn tableName="chart" columnName="channel_id"/>
    </changeSet>
    <changeSet author="Jaera" id="6">
        <addColumn tableName="chart">
            <column name="owner_username" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet author="Jaera" id="7">
        <renameColumn tableName="chart" oldColumnName="server_id" newColumnName="guild_id" />
    </changeSet>
    <changeSet author="Jaera" id="8">
        <addColumn tableName="ab_history">
            <column name="roll_value" type="integer">
                <constraints nullable="false" />
            </column>
        </addColumn>
        <renameColumn tableName="ab_history" oldColumnName="server_id" newColumnName="guild_id" />
        <createTable tableName="ab_history_individual_rolls">
            <column name="uuid" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sequence_number" type="integer">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="roll_value" type="integer">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
    <changeSet author="Jaera" id="9">
        <addForeignKeyConstraint
                baseColumnNames="uuid"
                baseTableName="ab_history_individual_rolls"
                referencedColumnNames="uuid"
                referencedTableName="ab_history"
                constraintName="ab_history_uuid_fk"
        />
    </changeSet>
    <changeSet author="Jaera" id="10">
        <renameTable oldTableName="player_lookup" newTableName="player" />
        <createTable tableName="player_position">
            <column name="uuid" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="position" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false" />
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseColumnNames="uuid"
                baseTableName="player_position"
                referencedColumnNames="uuid"
                referencedTableName="player"
                constraintName="player_position_uuid_fk"
        />
    </changeSet>
    <changeSet author="Jaera" id="11">
        <validCheckSum>any</validCheckSum>
        <renameColumn tableName="player" oldColumnName="batter_card_path" newColumnName="card_url" />
        <renameColumn tableName="player" oldColumnName="pitcher_card_path" newColumnName="player_type" />
    </changeSet>
    <changeSet author="Jaera" id="12">
        <addColumn tableName="chart">
            <column name="roll" type="VARCHAR(30)" />
        </addColumn>
    </changeSet>
    <changeSet author="Jaera" id="13">
        <modifyDataType tableName="chart" columnName="chart_name" newDataType="text"/>
        <modifyDataType tableName="chart_usage" columnName="chart_name" newDataType="text"/>
        <modifyDataType tableName="custom_command" columnName="command_name" newDataType="text"/>
        <modifyDataType tableName="custom_command_usage" columnName="command_name" newDataType="text"/>
    </changeSet>
    <changeSet author="Jaera" id="14">
        <renameColumn tableName="custom_command_usage" oldColumnName="server_id" newColumnName="guild_id" />
        <renameColumn tableName="custom_command_usage" oldColumnName="calling_username" newColumnName="calling_userid" />
    </changeSet>
    <changeSet author="Jaera" id="15">
        <createTable tableName="message_pagination">
            <column name="message_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="guild_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="range_low" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="range_high" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="created_timestamp" type="timestamp with time zone"/>
            <column name="updated_timestamp" type="timestamp with time zone"/>
        </createTable>
    </changeSet>
    <changeSet author="Jaera" id="16">
        <renameColumn tableName="message_pagination" oldColumnName="range_low" newColumnName="page" />
        <dropColumn tableName="message_pagination" columnName="range_high" />
    </changeSet>
    <changeSet author="Jaera" id="17">
        <createTable tableName="user_settings">
            <column name="user_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="guild_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="primary_color" type="VARCHAR(7)"/>
            <column name="secondary_color" type="VARCHAR(7)"/>
            <column name="created_timestamp" type="timestamp with time zone"/>
            <column name="updated_timestamp" type="timestamp with time zone"/>
        </createTable>
    </changeSet>
    <changeSet author="Jaera" id="18">
        <addColumn tableName="user_settings">
            <column name="text_color" type="VARCHAR(25)"/>
            <column name="background_color" type="VARCHAR(25)"/>
        </addColumn>
        <dropColumn tableName="user_settings" columnName="secondary_color" />
    </changeSet>
    <changeSet author="Jaera" id="19">
        <dropColumn tableName="user_settings" columnName="background_color" />
    </changeSet>
    <changeSet author="Jaera" id="20">
        <modifyDataType tableName="custom_command" columnName="link" newDataType="text" />
    </changeSet>
    <changeSet author="Jaera" id="21">
        <createTable tableName="game_context">
            <column name="server_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="channel_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sheet_link" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="Jaera" id="22">
        <createTable tableName="game_report_history">
            <column name="game_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sheet_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="channel_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="posted_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="Jaera" id="23">
        <createTable tableName="transaction_report_history">
            <column name="trans_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="channel_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="posted_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="Jaera" id="24">
        <addColumn tableName="player">
            <column name="injury" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet author="Jaera" id="25">
        <createTable tableName="job_settings">
            <column name="job_name" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cron_schedule" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="Jaera" id="26">
        <createTable tableName="achievement">
            <column name="user_id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="achievement_name" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="level" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="earned_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="Jaera" id="27">
        <addColumn tableName="achievement">
            <column name="cancelled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>